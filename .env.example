# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://mohamedwelijama.com"

# ---------------------------------------------------------------------------
# Admin dashboard credentials (§23)
#
# Generate all three values with:   npm run admin:password
# It prompts for a password, prints the hash, and never stores the password.
# Put the real values in .env.local, which is gitignored. Never commit them.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="scrypt:<salt-hex>:<hash-hex>"
AUTH_SECRET="<random 32+ character string>"
